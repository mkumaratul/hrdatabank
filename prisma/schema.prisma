// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HrUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  reviewedCandidates Candidate[] @relation("ReviewedCandidates")
  uploadedCandidates Candidate[] @relation("UploadedCandidates")
  jobDescriptions    JobDescription[]
}

model Candidate {
  id            String          @id @default(cuid())
  name          String?
  email         String?
  phone         String?
  skillCategory String?
  status        String  @default("PENDING")
  statusReason  String?
  interviewDate DateTime?

  experience   String?
  currentCtc   String?
  expectedCtc  String?
  noticePeriod String?
  location     String?
  workLinks    String[] @default([])

  fileName String
  mimeType String
  fileData Bytes?
  rawText  String?

  cloudinaryPublicId   String?
  cloudinaryResourceType String?

  reviewedById String?
  reviewedBy   HrUser? @relation("ReviewedCandidates", fields: [reviewedById], references: [id])

  uploadedById String?
  uploadedBy   HrUser? @relation("UploadedCandidates", fields: [uploadedById], references: [id])

  remarks     Remark[]
  attachments CandidateAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CandidateAttachment {
  id       String @id @default(cuid())
  fileName String
  mimeType String
  fileData Bytes?

  cloudinaryPublicId     String?
  cloudinaryResourceType String?

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Remark {
  id          String   @id @default(cuid())
  text        String
  createdAt   DateTime @default(now())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model JobDescription {
  id      String @id @default(cuid())
  title   String
  content String

  createdById String
  createdBy   HrUser @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
