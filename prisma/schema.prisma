// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CandidateStatus {
  PENDING
  SELECTED
  REJECTED
  WAITLIST
  INTERVIEW_TO_BE_SCHEDULED
  INTERVIEW_SCHEDULED
  INTERVIEW_CANCELLED
}

model HrUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  reviewedCandidates Candidate[] @relation("ReviewedCandidates")
  uploadedCandidates Candidate[] @relation("UploadedCandidates")
}

model Candidate {
  id            String          @id @default(cuid())
  name          String?
  email         String?
  phone         String?
  skillCategory String?
  status        CandidateStatus @default(PENDING)
  statusReason  String?

  experience   String?
  currentCtc   String?
  expectedCtc  String?
  noticePeriod String?
  location     String?
  workLinks    String[] @default([])

  fileName String
  mimeType String
  fileData Bytes
  rawText  String?

  reviewedById String?
  reviewedBy   HrUser? @relation("ReviewedCandidates", fields: [reviewedById], references: [id])

  uploadedById String?
  uploadedBy   HrUser? @relation("UploadedCandidates", fields: [uploadedById], references: [id])

  remarks Remark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Remark {
  id          String   @id @default(cuid())
  text        String
  createdAt   DateTime @default(now())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}
